---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import defaultOgImage from "../assets/images/og-default.jpg";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  imageAlt?: string;
  ogType?: "website" | "article";
}

const {
  title,
  description,
  image,
  imageAlt = "Shuhey Koyama",
  ogType = "website",
} = Astro.props;

const ogImage = await getImage({
  src: image ?? defaultOgImage,
  width: 1200,
  height: 630,
  fit: "cover",
  position: "center",
  format: "jpeg",
  quality: 80,
});

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage.src, Astro.site);
const ogWidth = ogImage.attributes.width ?? ogImage.options.width ?? 1200;
const ogHeight = ogImage.attributes.height ?? ogImage.options.height ?? 630;
---

<!-- SEO -->
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:width" content={String(ogWidth)} />
<meta property="og:image:height" content={String(ogHeight)} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:site_name" content="Shuhey Koyama" />
<meta property="og:locale" content="en_US" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@shuheykoyama" />
<meta name="twitter:creator" content="@shuheykoyama" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
