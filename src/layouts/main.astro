---
import Footer from "../components/footer.astro";
import Header from "../components/header.astro";
import SquareLines from "../components/square-lines.astro";
import CursorEffect from "../components/cursor-effect.astro";
import BaseHead from "../components/base-head.astro";
import "../assets/css/main.css";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  imageAlt?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
}

const { title, description, image, imageAlt, ogType, noindex } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <BaseHead
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      ogType={ogType}
      noindex={noindex}
    />

    <script is:inline>
      if (typeof Storage !== 'undefined') {
        const darkMode = localStorage.getItem('dark_mode');
        if (darkMode === null) {
          localStorage.setItem('dark_mode', 'true');
        } else if (darkMode === 'false') {
          document.documentElement.classList.remove('dark');
        }
      }
    </script>

    <style>
      .prose img {
        border-radius: 20px;
      }
    </style>
    <style is:global>
      .prose .image-grid > p {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.25rem;
        margin: 0;
      }
      @media (min-width: 640px) {
        .prose .image-grid > p {
          grid-template-columns: repeat(2, 1fr);
        }
      }
      .prose .image-grid img {
        width: 100%;
        height: auto;
        object-fit: cover;
        margin: 0;
        border-radius: 20px;
      }
    </style>
    <link rel="icon" type="image/x-icon" href="/assets/images/favicon.ico" />
    <Fragment set:html={import.meta.env.HEADER_INJECT} />
  </head>
  <body class="antialiased bg-white dark:bg-neutral-950">
    <CursorEffect />
    <SquareLines />
    <Header />
    <slot />
    <Footer />
    <script src="../assets/js/main.js"></script>
    <Fragment set:html={import.meta.env.FOOTER_INJECT} />
  </body>
</html>
